# ====================================
# Environment Variables Configuration
# ====================================
# Copy this file to .env and fill in your actual SECRET values
# DO NOT commit the .env file to version control
#
# This file contains ONLY secrets (passwords, API keys, tokens)
# Non-secret configuration (infrastructure bindings, business rules, feature flags) 
# are kept in JSON files or code for better version control and visibility
# ====================================

# Environment (development, production)
ENV=development

# ====================================
# Database & DAL Configuration - SECRETS ONLY
# ====================================
# Service and anon keys are secrets
DAL_SERV_KEY=your-service-key-here
DAL_ANON_KEY=your-anon-key-here

# Database URL is kept in data/json/dal/*.json (infrastructure binding)

# ====================================
# Supabase Configuration - SECRETS ONLY
# ====================================
# Keys are secrets
SUPABASE_SERV_KEY=your-service-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase URL is kept in data/json/supabase/*.json (infrastructure binding)

# ====================================
# Redis Configuration - SECRETS ONLY
# ====================================
# Password is secret
REDIS_PASSWORD=your-redis-password

# Redis host, port, db are kept in data/json/redis/*.json (infrastructure binding)

# ====================================
# WeChat Configuration - SECRETS ONLY
# ====================================
# Only secrets (app secret) go here
# AppIDs are kept in code (not secret, public identifiers)

# WeChat Mini Program Secret
WEIXIN_PARTNER_UP_WXMP_SECRET=your-wxmp-secret-here

# WeChat Service Account
WEIXIN_PARTNER_UP_WXSA_APPID=your-wxsa-appid-here
WEIXIN_PARTNER_UP_WXSA_SECRET=your-wxsa-secret-here

# WeChat message template IDs are kept in data/json/weixin/*.json (business rules)

# ====================================
# WeChat Pay Configuration - SECRETS ONLY
# ====================================
# API V3 Key is secret
WECHAT_PAY_API_V3_KEY=your-api-v3-key-here

# Other WeChat Pay config (mchid, paths, serial_no, sign_type) 
# are kept in data/json/wechat_pay/*.json (not secrets)

# ====================================
# LBS Configuration - SECRETS ONLY
# ====================================
# API key is secret
LBS_APIKEY=your-lbs-api-key-here

# ====================================
# Auth Configuration - SECRETS ONLY
# ====================================
# JWT secret key is secret
JWT_SECRET_KEY=your-jwt-secret-key-here

# JWT audiences are kept in code (business rules, not secrets)
